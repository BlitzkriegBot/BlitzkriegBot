{
  "version": 2,
  "name": "kline_probe",
  "meta": {
    "description": "Replay diagnostic probe blueprint: spot return >= 20 bps with >= 60s left.",
    "holds_to_settlement": false,
    "entry_maker": false,
    "once_per_round": true,
    "thesis_death": false
  },
  "nodes": [
    {
      "id": "c_spot",
      "type": "condition",
      "params": {
        "field": "tick.spot_return_bps",
        "op": ">=",
        "value": 20
      }
    },
    {
      "id": "c_tl_min",
      "type": "condition",
      "params": {
        "field": "tick.time_left_sec",
        "op": ">=",
        "value": 60
      }
    },
    {
      "id": "act_buy",
      "type": "action_buy",
      "params": {
        "budget_ratio": 0.05
      }
    },
    {
      "id": "gate_and",
      "type": "logic_and",
      "params": {}
    }
  ],
  "edges": [
    {
      "from": "c_spot",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_tl_min",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "gate_and",
      "to": "act_buy",
      "when": true
    }
  ]
}
