{
  "version": 2,
  "name": "late_favorite",
  "meta": {
    "description": "Near-settlement favorite (BTC only): 45-60s left, buy BTC side in [0.85, 0.97] and hold to settlement.",
    "holds_to_settlement": true,
    "entry_maker": false,
    "once_per_round": true,
    "thesis_death": false,
    "gate_exemptions": {
      "timing": true,
      "momentum": false,
      "timing_min_time_left_sec": 45
    }
  },
  "nodes": [
    {
      "id": "c_asset",
      "type": "condition",
      "params": {
        "field": "tick.asset",
        "op": "==",
        "value": "BTC"
      }
    },
    {
      "id": "c_tl_min",
      "type": "condition",
      "params": {
        "field": "tick.time_left_sec",
        "op": ">=",
        "value": 45
      }
    },
    {
      "id": "c_tl_max",
      "type": "condition",
      "params": {
        "field": "tick.time_left_sec",
        "op": "<=",
        "value": 60
      }
    },
    {
      "id": "c_px_min",
      "type": "condition",
      "params": {
        "field": "tick.price",
        "op": ">=",
        "value": 0.85
      }
    },
    {
      "id": "c_px_max",
      "type": "condition",
      "params": {
        "field": "tick.price",
        "op": "<=",
        "value": 0.97
      }
    },
    {
      "id": "act_buy",
      "type": "action_buy",
      "params": {
        "budget_ratio": 0.1
      }
    },
    {
      "id": "gate_and",
      "type": "logic_and",
      "params": {}
    }
  ],
  "edges": [
    {
      "from": "c_asset",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_tl_min",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_tl_max",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_px_min",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_px_max",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "gate_and",
      "to": "act_buy",
      "when": true
    }
  ]
}
