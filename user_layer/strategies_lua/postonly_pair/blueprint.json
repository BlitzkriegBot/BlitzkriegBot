{
  "version": 2,
  "name": "postonly_pair",
  "meta": {
    "description": "Post-only paired maker collector: pair_bid_sum <= 0.975 with >= 60s left.",
    "holds_to_settlement": true,
    "entry_maker": true,
    "once_per_round": true,
    "thesis_death": false
  },
  "nodes": [
    {
      "id": "c_pair",
      "type": "condition",
      "params": {
        "field": "tick.pair_bid_sum",
        "op": "<=",
        "value": 0.975
      }
    },
    {
      "id": "c_tl_min",
      "type": "condition",
      "params": {
        "field": "tick.time_left_sec",
        "op": ">=",
        "value": 60
      }
    },
    {
      "id": "act_pair",
      "type": "action_buy_pair",
      "params": {
        "maker": true,
        "budget_ratio": 0.1
      }
    },
    {
      "id": "gate_and",
      "type": "logic_and",
      "params": {}
    }
  ],
  "edges": [
    {
      "from": "c_pair",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_tl_min",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "gate_and",
      "to": "act_pair",
      "when": true
    }
  ]
}
