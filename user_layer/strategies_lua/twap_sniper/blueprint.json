{
  "version": 2,
  "name": "twap_sniper",
  "meta": {
    "description": "Final-15s TWAP-lock sniper for 5m binary rounds: 5-15s left, buy favorite in [0.85, 0.97].",
    "holds_to_settlement": true,
    "entry_maker": false,
    "once_per_round": true,
    "thesis_death": false,
    "gate_exemptions": {
      "timing": true,
      "momentum": false,
      "timing_min_time_left_sec": 5
    }
  },
  "nodes": [
    {
      "id": "c_tl_min",
      "type": "condition",
      "params": {
        "field": "tick.time_left_sec",
        "op": ">=",
        "value": 5
      }
    },
    {
      "id": "c_tl_max",
      "type": "condition",
      "params": {
        "field": "tick.time_left_sec",
        "op": "<=",
        "value": 15
      }
    },
    {
      "id": "c_px_min",
      "type": "condition",
      "params": {
        "field": "tick.price",
        "op": ">=",
        "value": 0.85
      }
    },
    {
      "id": "c_px_max",
      "type": "condition",
      "params": {
        "field": "tick.price",
        "op": "<=",
        "value": 0.97
      }
    },
    {
      "id": "act_buy",
      "type": "action_buy",
      "params": {
        "budget_ratio": 0.1
      }
    },
    {
      "id": "gate_and",
      "type": "logic_and",
      "params": {}
    }
  ],
  "edges": [
    {
      "from": "c_tl_min",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_tl_max",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_px_min",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_px_max",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "gate_and",
      "to": "act_buy",
      "when": true
    }
  ]
}
