{
  "version": 2,
  "name": "lua_momentum",
  "meta": {
    "description": "Momentum scalper: mid-round maker entry on positive OBI and affordable leg [0.15, 0.55].",
    "holds_to_settlement": true,
    "entry_maker": true,
    "once_per_round": false,
    "thesis_death": false
  },
  "nodes": [
    {
      "id": "c_tl_min",
      "type": "condition",
      "params": {
        "field": "tick.time_left_sec",
        "op": ">=",
        "value": 60
      }
    },
    {
      "id": "c_obi",
      "type": "condition",
      "params": {
        "field": "tick.obi",
        "op": ">=",
        "value": 0.15
      }
    },
    {
      "id": "c_px_min",
      "type": "condition",
      "params": {
        "field": "tick.price",
        "op": ">=",
        "value": 0.15
      }
    },
    {
      "id": "c_px_max",
      "type": "condition",
      "params": {
        "field": "tick.price",
        "op": "<=",
        "value": 0.55
      }
    },
    {
      "id": "act_buy",
      "type": "action_buy",
      "params": {
        "maker": true,
        "budget_ratio": 0.1
      }
    },
    {
      "id": "gate_and",
      "type": "logic_and",
      "params": {}
    }
  ],
  "edges": [
    {
      "from": "c_tl_min",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_obi",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_px_min",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_px_max",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "gate_and",
      "to": "act_buy",
      "when": true
    }
  ]
}
