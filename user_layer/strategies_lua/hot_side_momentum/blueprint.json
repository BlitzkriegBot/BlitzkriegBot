{
  "version": 2,
  "name": "hot_side_momentum",
  "meta": {
    "description": "Confirmed-leader holder: round 40%-70% elapsed, spot move >= 15 bps, favorite in [0.65, 0.88].",
    "holds_to_settlement": true,
    "entry_maker": false,
    "once_per_round": true,
    "thesis_death": false
  },
  "nodes": [
    {
      "id": "c_el_min",
      "type": "condition",
      "params": {
        "field": "tick.elapsed_pct",
        "op": ">=",
        "value": 0.4
      }
    },
    {
      "id": "c_el_max",
      "type": "condition",
      "params": {
        "field": "tick.elapsed_pct",
        "op": "<=",
        "value": 0.7
      }
    },
    {
      "id": "c_spot",
      "type": "condition",
      "params": {
        "field": "tick.spot_return_bps",
        "op": ">=",
        "value": 15
      }
    },
    {
      "id": "c_px_min",
      "type": "condition",
      "params": {
        "field": "tick.price",
        "op": ">=",
        "value": 0.65
      }
    },
    {
      "id": "c_px_max",
      "type": "condition",
      "params": {
        "field": "tick.price",
        "op": "<=",
        "value": 0.88
      }
    },
    {
      "id": "act_buy",
      "type": "action_buy",
      "params": {
        "budget_ratio": 0.1
      }
    },
    {
      "id": "gate_and",
      "type": "logic_and",
      "params": {}
    }
  ],
  "edges": [
    {
      "from": "c_el_min",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_el_max",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_spot",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_px_min",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "c_px_max",
      "to": "gate_and",
      "when": true
    },
    {
      "from": "gate_and",
      "to": "act_buy",
      "when": true
    }
  ]
}
